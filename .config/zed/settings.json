{
  "edit_predictions": {
    "provider": "copilot",
  },
  "auto_update": false,
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "cursor_blink": false,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  "terminal": {
    "blinking": "off",
  },
  "agent_buffer_font_size": 13,
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 13,
  "ui_font_family": "Source Han Serif CN",
  "ui_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Light",
  },
  "languages": {},
}
